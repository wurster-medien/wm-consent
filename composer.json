{
    "name": "wurster-medien/wm-consent",
    "description": "Cookie-Banner von Wurster Medien für Statamic (und MODX): Zustimmung, blockierte Tracker, Platzhalter für Videos und Karten.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": ["statamic", "cookie", "consent", "dsgvo"],
    "authors": [
        {
            "name": "Wurster Medien",
            "email": "dev@wurster-medien.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.0 || ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "WursterMedien\\Consent\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WursterMedien\\Consent\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "WM Consent",
            "slug": "wm-consent",
            "description": "Cookie-Banner von Wurster Medien"
        },
        "laravel": {
            "providers": [
                "WursterMedien\\Consent\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
